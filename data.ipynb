    "from scipy.stats import mannwhitneyu\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "stocks_df = stocks_df.sort_values([\"Ticker\", \"Date\"]).copy()\n",
    "\n",
    "stocks_df[\"Future_Return_20d\"] = (\n",
    "    stocks_df.groupby(\"Ticker\")[\"Close\"].shift(-20) - stocks_df[\"Close\"]\n",
    ") / stocks_df[\"Close\"]\n",
    "\n",
    "features = [\n",
    "    \"RSI_14\", \"MACD\", \"MACD_Signal\", \"Volatility_7d\",\n",
    "    \"Daily_Return\", \"Volume\"\n",
    "]\n",
    "\n",
    "optional_features = [\"Return_7d\", \"Return_14d\", \"Volatility_14d\", \"Volume_z\"]\n",
    "\n",
    "for feature in optional_features:\n",
    "    if feature in stocks_df.columns:\n",
    "        features.append(feature)\n",
    "\n",
    "# Drop missing values, then create target\n",
    "test_df = stocks_df[[\"Future_Return_20d\"] + features].dropna().copy()\n",
    "test_df[\"Target\"] = (test_df[\"Future_Return_20d\"] > 0.01).astype(int)\n",
    "\n",
    "# Mann-Whitney U tests\n",
    "results = []\n",
    "\n",
    "for feature in features:\n",
    "    group_0 = test_df.loc[test_df[\"Target\"] == 0, feature]\n",
    "    group_1 = test_df.loc[test_df[\"Target\"] == 1, feature]\n",
    "\n",
    "    stat, p_value = mannwhitneyu(group_0, group_1, alternative=\"two-sided\")\n",
    "\n",
    "    results.append({\n",
    "        \"Feature\": feature,\n",
    "        \"Target 0 Median\": group_0.median(),\n",
    "        \"Target 1 Median\": group_1.median(),\n",
    "        \"P-Value\": p_value,\n",
    "        \"Significant\": p_value < 0.05\n",
    "    })\n",
    "\n",
    "mannwhitney_results = pd.DataFrame(results)\n",
    "mannwhitney_results"
   ]
